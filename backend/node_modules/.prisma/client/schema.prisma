  schools       School   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([school_id, created_at(sort: Desc)], map: "idx_audit_created_at")
  @@index([school_id, resource_type, resource_id], map: "idx_audit_school_resource")
  @@schema("school")
}

model communication_usage_ledger {
