  roles      Role?    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sections   Section? @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notice_recipients")
  @@schema("school")
}

model SchoolEvent {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String       @db.Uuid
  academic_year_id String       @db.Uuid
  title            String       @db.VarChar(200)
