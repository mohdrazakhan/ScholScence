model TimetablePeriod {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String    @db.Uuid
  academic_year_id String    @db.Uuid
  section_id       String    @db.Uuid
  class_subject_id String?   @db.Uuid
  teacher_id       String?   @db.Uuid
  day_of_week      String    @db.VarChar(20)
  period_number    Int
  start_time       String    @db.VarChar(10)
  end_time         String    @db.VarChar(10)
  slot_type        String    @default("ACADEMIC") @db.VarChar(30)
  title            String?   @db.VarChar(100)
  room_number      String?   @db.VarChar(50)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  school        School        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academic_year AcademicYear  @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  section       Section       @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  class_subject ClassSubject? @relation(fields: [class_subject_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  teacher       User?         @relation(fields: [teacher_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([school_id, section_id, day_of_week], map: "idx_timetable_section_day")
  @@index([school_id, teacher_id, day_of_week], map: "idx_timetable_teacher_day")
  @@map("timetable_periods")
  @@schema("school")
}
