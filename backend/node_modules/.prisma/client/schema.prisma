  school           School            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notices")
  @@schema("school")
}

model NoticeRecipient {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notice_id  String   @db.Uuid
  class_id   String?  @db.Uuid
  section_id String?  @db.Uuid
  role_id    String?  @db.Uuid
  classes    Class?   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
