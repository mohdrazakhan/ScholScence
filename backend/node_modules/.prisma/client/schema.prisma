generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "school"]
}

model User {
  id                                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                               String?                           @db.VarChar(255)
  phone                               String?                           @db.VarChar(20)
  password_hash                       String
  first_name                          String                            @db.VarChar(100)
  last_name                           String?                           @db.VarChar(100)
  status                              String                            @default("ACTIVE") @db.VarChar(20)
  email_verified_at                   DateTime?                         @db.Timestamptz(6)
  phone_verified_at                   DateTime?                         @db.Timestamptz(6)
  last_login_at                       DateTime?                         @db.Timestamptz(6)
  created_at                          DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                         @db.Timestamptz(6)
  user_school_roles                   UserSchoolRole[]
  attendance_marked                   Attendance[]
  audit_logs                          audit_logs[]
  complaint_messages                  ComplaintMessage[]
  complaints                          Complaint[]
  events_created                      SchoolEvent[]
  guardians                           Guardian[]
  homework_assigned                   Homework[]
  notices_published                   Notice[]
  notification_deliveries             notification_deliveries[]
  section_subject_teacher_assignments SectionSubjectTeacherAssignment[]
  section_teacher_assignments         SectionTeacherAssignment[]
  student_marks_entered               StudentMark[]
  timetable_periods                   TimetablePeriod[]

  @@map("users")
  @@schema("identity")
}

model Role {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String?           @db.Uuid
  name              String            @db.VarChar(100)
  code              String            @db.VarChar(100)
  description       String?
  is_system_role    Boolean           @default(false)
  status            String            @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  role_permissions  RolePermission[]
  schools           School?           @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_roles_school")
  user_school_roles UserSchoolRole[]
  notice_recipients NoticeRecipient[]

  @@unique([school_id, code], map: "uq_roles_school_code")
  @@map("roles")
  @@schema("identity")
}

model Permission {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String           @db.VarChar(150)
  code             String           @unique @db.VarChar(150)
  module           String           @db.VarChar(100)
  action           String           @db.VarChar(50)
  description      String?
  status           String           @default("ACTIVE") @db.VarChar(20)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?        @db.Timestamptz(6)
  role_permissions RolePermission[]

  @@unique([module, action], map: "uq_permissions_module_action")
  @@map("permissions")
  @@schema("identity")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@map("role_permissions")
  @@schema("identity")
}

model UserSchoolRole {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  school_id  String    @db.Uuid
  role_id    String    @db.Uuid
  status     String    @default("ACTIVE") @db.VarChar(20)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  role       Role      @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_school_roles_role")
  school     School    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_school_roles_school")
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_school_roles_user")

  @@unique([user_id, school_id, role_id], map: "uq_user_school_role")
  @@map("user_school_roles")
  @@schema("identity")
}

model School {
  id                                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                String                            @db.VarChar(200)
  code                                String                            @unique @db.VarChar(50)
  email                               String?                           @db.VarChar(255)
  phone                               String?                           @db.VarChar(20)
  address_line1                       String?                           @db.VarChar(255)
  address_line2                       String?                           @db.VarChar(255)
  city                                String?                           @db.VarChar(100)
  state                               String?                           @db.VarChar(100)
  country                             String?                           @default("India") @db.VarChar(100)
  postal_code                         String?                           @db.VarChar(20)
  status                              String                            @default("ACTIVE") @db.VarChar(20)
  created_at                          DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                         @db.Timestamptz(6)
  roles                               Role[]
  user_school_roles                   UserSchoolRole[]
  academic_years                      AcademicYear[]
  attendance                          Attendance[]
  audit_logs                          audit_logs[]
  classes                             Class[]
  communication_usage_ledger          communication_usage_ledger[]
  complaints                          Complaint[]
  events                              SchoolEvent[]
  exams                               Exam[]
  fee_categories                      fee_categories[]
  fee_structures                      fee_structures[]
  grading_schemes                     GradingScheme[]
  guardians                           Guardian[]
  homework                            Homework[]
  notices                             Notice[]
  notification_deliveries             notification_deliveries[]
  notification_events                 notification_events[]
  branches                            SchoolBranch[]
  section_subject_teacher_assignments SectionSubjectTeacherAssignment[]
  section_teacher_assignments         SectionTeacherAssignment[]
  sections                            Section[]
  student_fee_invoices                student_fee_invoices[]
  student_guardians                   StudentGuardian[]
  student_marks                       StudentMark[]
  students                            Student[]
  subjects                            Subject[]
  timetable_periods                   TimetablePeriod[]

  @@map("schools")
  @@schema("school")
}

model SchoolBranch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String    @db.Uuid
  name          String    @db.VarChar(200)
  code          String    @db.VarChar(50)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  address_line1 String?   @db.VarChar(255)
  address_line2 String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  country       String?   @default("India") @db.VarChar(100)
  postal_code   String?   @db.VarChar(20)
  status        String    @default("ACTIVE") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  school        School    @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_school_branches_school")
  sections      Section[]

  @@unique([school_id, code], map: "uq_school_branches_code")
  @@map("school_branches")
  @@schema("school")
}

model AcademicYear {
  id                                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                           String                            @db.Uuid
  name                                String                            @db.VarChar(20)
  start_date                          DateTime                          @db.Date
  end_date                            DateTime                          @db.Date
  is_current                          Boolean                           @default(false)
  status                              String                            @default("ACTIVE") @db.VarChar(20)
  created_at                          DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                         @db.Timestamptz(6)
  school                              School                            @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_academic_years_school")
  attendance                          Attendance[]
  class_subjects                      ClassSubject[]
  events                              SchoolEvent[]
  exams                               Exam[]
  fee_structures                      fee_structures[]
  homework                            Homework[]
  notices                             Notice[]
  section_subject_teacher_assignments SectionSubjectTeacherAssignment[]
  section_teacher_assignments         SectionTeacherAssignment[]
  sections                            Section[]
  student_enrollments                 StudentEnrollment[]
  student_fee_invoices                student_fee_invoices[]
  timetable_periods                   TimetablePeriod[]

  @@unique([school_id, name], map: "uq_academic_years_name")
  @@map("academic_years")
  @@schema("school")
}

model Class {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String            @db.Uuid
  name              String            @db.VarChar(100)
  code              String            @db.VarChar(50)
  display_order     Int               @default(0)
  status            String            @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  class_subjects    ClassSubject[]
  school            School            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_classes_school")
  fee_structures    fee_structures[]
  notice_recipients NoticeRecipient[]
  sections          Section[]

  @@unique([school_id, code], map: "uq_classes_school_code")
  @@map("classes")
  @@schema("school")
}

model Section {
  id                                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id                           String                            @db.Uuid
  academic_year_id                    String                            @db.Uuid
  class_id                            String                            @db.Uuid
  name                                String                            @db.VarChar(100)
  code                                String                            @db.VarChar(50)
  capacity                            Int?
  display_order                       Int                               @default(0)
  status                              String                            @default("ACTIVE") @db.VarChar(20)
  created_at                          DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                         @db.Timestamptz(6)
  branch_id                           String                            @db.Uuid
  attendance                          Attendance[]
  homework                            Homework[]
  notice_recipients                   NoticeRecipient[]
  section_subject_teacher_assignments SectionSubjectTeacherAssignment[]
  section_teacher_assignments         SectionTeacherAssignment[]
  timetable_periods                   TimetablePeriod[]
  academic_year                       AcademicYear                      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sections_academic_year")
  branch                              SchoolBranch                      @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sections_branch")
  class                               Class                             @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sections_class")
  schools                             School                            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sections_school")
  student_enrollments                 StudentEnrollment[]

  @@unique([branch_id, academic_year_id, class_id, code], map: "uq_sections_branch_year_class_code")
  @@map("sections")
  @@schema("school")
}

model Subject {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id      String         @db.Uuid
  name           String         @db.VarChar(150)
  code           String         @db.VarChar(50)
  description    String?
  subject_type   String         @default("ACADEMIC") @db.VarChar(30)
  display_order  Int            @default(0)
  status         String         @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?      @db.Timestamptz(6)
  class_subjects ClassSubject[]
  school         School         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subjects_school")

  @@unique([school_id, code], map: "uq_subjects_school_code")
  @@map("subjects")
  @@schema("school")
}

model ClassSubject {
  id                                  String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  academic_year_id                    String                            @db.Uuid
  class_id                            String                            @db.Uuid
  subject_id                          String                            @db.Uuid
  is_optional                         Boolean                           @default(false)
  display_order                       Int                               @default(0)
  status                              String                            @default("ACTIVE") @db.VarChar(20)
  created_at                          DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at                          DateTime?                         @db.Timestamptz(6)
  attendance                          Attendance[]
  academic_year                       AcademicYear                      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_class_subjects_academic_year")
  class                               Class                             @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_class_subjects_class")
  subject                             Subject                           @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_class_subjects_subject")
  exam_subjects                       ExamSubject[]
  homework                            Homework[]
  section_subject_teacher_assignments SectionSubjectTeacherAssignment[]
  timetable_periods                   TimetablePeriod[]

  @@unique([academic_year_id, class_id, subject_id], map: "uq_class_subject_year")
  @@map("class_subjects")
  @@schema("school")
}

model Student {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String                 @db.Uuid
  admission_number     String                 @db.VarChar(50)
  first_name           String                 @db.VarChar(100)
  middle_name          String?                @db.VarChar(100)
  last_name            String?                @db.VarChar(100)
  date_of_birth        DateTime?              @db.Date
  gender               String?                @db.VarChar(20)
  blood_group          String?                @db.VarChar(10)
  photo_url            String?
  status               String                 @default("ACTIVE") @db.VarChar(20)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  attendance           Attendance[]
  complaints           Complaint[]
  student_enrollments  StudentEnrollment[]
  student_fee_invoices student_fee_invoices[]
  student_guardians    StudentGuardian[]
  student_marks        StudentMark[]
  school               School                 @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_students_school")

  @@unique([school_id, admission_number], map: "uq_students_school_admission")
  @@map("students")
  @@schema("school")
}

model StudentEnrollment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id       String       @db.Uuid
  academic_year_id String       @db.Uuid
  section_id       String       @db.Uuid
  roll_number      String?      @db.VarChar(50)
  enrollment_date  DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  status           String       @default("ACTIVE") @db.VarChar(20)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollments_academic_year")
  section          Section      @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollments_section")
  student          Student      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollments_student")

  @@unique([student_id, academic_year_id], map: "uq_student_academic_year")
  @@map("student_enrollments")
  @@schema("school")
}

model Guardian {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String            @db.Uuid
  user_id           String?           @db.Uuid
  first_name        String            @db.VarChar(100)
  last_name         String?           @db.VarChar(100)
  phone             String            @db.VarChar(20)
  email             String?           @db.VarChar(150)
  occupation        String?           @db.VarChar(100)
  annual_income     Decimal?          @db.Decimal(12, 2)
  address           String?
  status            String            @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  complaints        Complaint[]
  school            School            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              User?             @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  student_guardians StudentGuardian[]

  @@index([school_id, phone], map: "idx_guardians_school_phone")
  @@map("guardians")
  @@schema("school")
}

model StudentGuardian {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id            String    @db.Uuid
  student_id           String    @db.Uuid
  guardian_id          String    @db.Uuid
  relationship_type    String    @db.VarChar(30)
  is_primary_contact   Boolean   @default(false)
  is_emergency_contact Boolean   @default(false)
  can_pickup           Boolean   @default(true)
  status               String    @default("ACTIVE") @db.VarChar(20)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at           DateTime? @db.Timestamptz(6)
  guardian             Guardian  @relation(fields: [guardian_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools              School    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student              Student   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("student_guardians")
  @@schema("school")
}

model SectionTeacherAssignment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String       @db.Uuid
  academic_year_id String       @db.Uuid
  section_id       String       @db.Uuid
  user_id          String       @db.Uuid
  status           String       @default("ACTIVE") @db.VarChar(20)
  assigned_at      DateTime     @default(now()) @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_teacher_academic_year")
  schools          School       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_teacher_school")
  section          Section      @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_teacher_section")
  user             User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_teacher_user")

  @@map("section_teacher_assignments")
  @@schema("school")
}

model SectionSubjectTeacherAssignment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String       @db.Uuid
  academic_year_id String       @db.Uuid
  section_id       String       @db.Uuid
  class_subject_id String       @db.Uuid
  user_id          String       @db.Uuid
  status           String       @default("ACTIVE") @db.VarChar(20)
  assigned_at      DateTime     @default(now()) @db.Timestamptz(6)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?    @db.Timestamptz(6)
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ssta_academic_year")
  class_subject    ClassSubject @relation(fields: [class_subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ssta_class_subject")
  schools          School       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ssta_school")
  section          Section      @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ssta_section")
  user             User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ssta_user")

  @@map("section_subject_teacher_assignments")
  @@schema("school")
}

model Attendance {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String        @db.Uuid
  academic_year_id String        @db.Uuid
  student_id       String        @db.Uuid
  section_id       String        @db.Uuid
  class_subject_id String?       @db.Uuid
  date             DateTime      @db.Date
  period_number    Int?
  status           String        @default("PRESENT") @db.VarChar(20)
  reason           String?
  marked_by        String        @db.Uuid
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?     @db.Timestamptz(6)
  academic_year    AcademicYear  @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  class_subject    ClassSubject? @relation(fields: [class_subject_id], references: [id], onUpdate: NoAction)
  teacher          User          @relation(fields: [marked_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school           School        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  section          Section       @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student          Student       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([school_id, date], map: "idx_attendance_school_date")
  @@index([section_id, date], map: "idx_attendance_section_date")
  @@index([student_id, date], map: "idx_attendance_student_date")
  @@map("attendance")
  @@schema("school")
}

model Homework {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String               @db.Uuid
  academic_year_id String               @db.Uuid
  section_id       String               @db.Uuid
  class_subject_id String               @db.Uuid
  teacher_id       String               @db.Uuid
  title            String               @db.VarChar(200)
  description      String
  assigned_date    DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date         DateTime             @db.Date
  status           String               @default("PUBLISHED") @db.VarChar(20)
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?            @db.Timestamptz(6)
  academic_year    AcademicYear         @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  class_subject    ClassSubject         @relation(fields: [class_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  school           School               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  section          Section              @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher          User                 @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments      HomeworkAttachment[]

  @@index([section_id, due_date], map: "idx_homework_section_due")
  @@map("homework")
  @@schema("school")
}

model HomeworkAttachment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homework_id     String   @db.Uuid
  file_name       String   @db.VarChar(255)
  file_url        String
  file_size_bytes BigInt?
  file_type       String?  @db.VarChar(100)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  homework        Homework @relation(fields: [homework_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("homework_attachments")
  @@schema("school")
}

model GradingScheme {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id   String    @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  grades_json Json
  status      String    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  exams       Exam[]
  schools     School    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("grading_schemes")
  @@schema("school")
}

model Exam {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id         String         @db.Uuid
  academic_year_id  String         @db.Uuid
  name              String         @db.VarChar(150)
  code              String         @db.VarChar(50)
  start_date        DateTime       @db.Date
  end_date          DateTime       @db.Date
  grading_scheme_id String?        @db.Uuid
  status            String         @default("SCHEDULED") @db.VarChar(20)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?      @db.Timestamptz(6)
  exam_subjects     ExamSubject[]
  academic_year     AcademicYear   @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grading_scheme    GradingScheme? @relation(fields: [grading_scheme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school            School         @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("exams")
  @@schema("school")
}

model ExamSubject {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id          String        @db.Uuid
  class_subject_id String        @db.Uuid
  exam_date        DateTime?     @db.Date
  start_time       DateTime?     @db.Time(6)
  end_time         DateTime?     @db.Time(6)
  max_marks        Decimal       @default(100.00) @db.Decimal(6, 2)
  passing_marks    Decimal       @default(33.00) @db.Decimal(6, 2)
  status           String        @default("ACTIVE") @db.VarChar(20)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  class_subject    ClassSubject  @relation(fields: [class_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam             Exam          @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_marks    StudentMark[]

  @@unique([exam_id, class_subject_id], map: "uq_exam_class_subject")
  @@map("exam_subjects")
  @@schema("school")
}

model StudentMark {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id       String      @db.Uuid
  exam_subject_id String      @db.Uuid
  student_id      String      @db.Uuid
  marks_obtained  Decimal?    @db.Decimal(6, 2)
  is_absent       Boolean     @default(false)
  grade           String?     @db.VarChar(10)
  remarks         String?
  entered_by      String      @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?   @db.Timestamptz(6)
  teacher         User        @relation(fields: [entered_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exam_subject    ExamSubject @relation(fields: [exam_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools         School      @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student         Student     @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([exam_subject_id, student_id], map: "uq_exam_student_marks")
  @@map("student_marks")
  @@schema("school")
}

model Notice {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id        String            @db.Uuid
  academic_year_id String            @db.Uuid
  title            String            @db.VarChar(255)
  content          String
  published_by     String            @db.Uuid
  target_audience  String            @default("ALL") @db.VarChar(30)
  status           String            @default("PUBLISHED") @db.VarChar(20)
  published_at     DateTime          @default(now()) @db.Timestamptz(6)
  expires_at       DateTime?         @db.Timestamptz(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime?         @db.Timestamptz(6)
  recipients       NoticeRecipient[]
