# ============================================================
# SchoolSense Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

NODE_ENV=production
PORT=3000

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=SCHEMA
DATABASE_URL="postgresql://user:password@host:5432/schoolsense?schema=public"

# JWT Secrets — use long random strings in production
# Generate with: openssl rand -base64 64
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://your-custom-domain.com"
