# Secrets — NEVER commit
.env
.env.local
.env.production
.env.*.local

# Node
node_modules/
npm-debug.log*

# Build outputs
dist/
build/

# Angular cache
.angular/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs & NPM
*.log
logs/
.npm/
npm-debug.log*

# PDF Reports
*.pdf

# Prisma
backend/prisma/migrations/*.sql.bak
